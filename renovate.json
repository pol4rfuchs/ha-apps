{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "dependencyDashboard": true,
  "schedule": [
    "before 6am on wednesday"
  ],
  "packageRules": [
    {
      "matchFileNames": [
        "forgejo/**"
      ],
      "semanticCommitScope": "forgejo"
    },
    {
      "matchFileNames": [
        "intiface_central/**"
      ],
      "semanticCommitScope": "intiface_central"
    },
    {
      "matchFileNames": [
        "matrix_synapse/**"
      ],
      "semanticCommitScope": "matrix_synapse"
    },
    {
      "matchFileNames": [
        "navidrome/**"
      ],
      "semanticCommitScope": "navidrome"
    },
    {
      "matchFileNames": [
        "nginx_proxy_manager/**"
      ],
      "semanticCommitScope": "nginx_proxy_manager"
    },
    {
      "matchFileNames": [
        "ntfy/**"
      ],
      "semanticCommitScope": "ntfy"
    },
    {
      "matchFileNames": [
        "ntfy_manager/**"
      ],
      "semanticCommitScope": "ntfy_manager"
    },
    {
      "matchFileNames": [
        "nextcloud/**"
      ],
      "semanticCommitScope": "nextcloud"
    },
    {
      "matchFileNames": [
        "searxng/**"
      ],
      "semanticCommitScope": "searxng"
    },
    {
      "matchFileNames": [
        "teamspeak6/**"
      ],
      "semanticCommitScope": "teamspeak6"
    },
    {
      "matchFileNames": [
        "ts6_manager/**"
      ],
      "semanticCommitScope": "ts6_manager"
    },
    {
      "matchFileNames": [
        "unbound/**"
      ],
      "semanticCommitScope": "unbound"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "minimumReleaseAge": "0 days",
      "automerge": false,
      "groupName": "github-actions (digest pinning)"
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "enabled": false
    }
  ],
  "ignorePaths": [
    "wiki/**"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track NLnetLabs/unbound upstream releases for ARG UNBOUND_VERSION in unbound/Dockerfile. Tag-Format auf GitHub ist 'release-X.Y.Z', daher extractVersionTemplate. Bumpt nur die reine Upstream-Version, das manuelle '-haNN-pol4rN' Suffix in config.yaml bleibt unangetastet (siehe Release-Please-Ausnahme).",
      "managerFilePatterns": [
        "/^unbound/Dockerfile$/"
      ],
      "matchStrings": [
        "ARG UNBOUND_VERSION=(?<currentValue>.*?)\\n"
      ],
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "NLnetLabs/unbound",
      "extractVersionTemplate": "^release-(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Track etkecc/ketesa (ehem. Synapse Admin) releases. Das Script holt die Version zur Laufzeit live per GitHub API, dieser Fallback-Wert wird nur genutzt falls der API-Call fehlschlägt — Renovate haelt ihn trotzdem aktuell als Referenz/Dashboard-Sichtbarkeit.",
      "managerFilePatterns": [
        "/^matrix_synapse/rootfs/etc/cont-init\\.d/05-download-webapps\\.sh$/"
      ],
      "matchStrings": [
        "ADMIN_VERSION=\"(?<currentValue>v.*?)\"\\n"
      ],
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "etkecc/ketesa"
    }
  ]
}
