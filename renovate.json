{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "dependencyDashboard": true,
  "schedule": [
    "before 6am on wednesday"
  ],
  "packageRules": [
    {
      "matchFileNames": [
        "forgejo/**"
      ],
      "semanticCommitScope": "forgejo"
    },
    {
      "matchFileNames": [
        "intiface_central/**"
      ],
      "semanticCommitScope": "intiface_central"
    },
    {
      "matchFileNames": [
        "matrix_synapse/**"
      ],
      "semanticCommitScope": "matrix_synapse"
    },
    {
      "matchFileNames": [
        "navidrome/**"
      ],
      "semanticCommitScope": "navidrome"
    },
    {
      "matchFileNames": [
        "nginx_proxy_manager/**"
      ],
      "semanticCommitScope": "nginx_proxy_manager"
    },
    {
      "matchFileNames": [
        "ntfy/**"
      ],
      "semanticCommitScope": "ntfy"
    },
    {
      "matchFileNames": [
        "ntfy_manager/**"
      ],
      "semanticCommitScope": "ntfy_manager"
    },
    {
      "matchFileNames": [
        "nextcloud/**"
      ],
      "semanticCommitScope": "nextcloud"
    },
    {
      "matchFileNames": [
        "searxng/**"
      ],
      "semanticCommitScope": "searxng"
    },
    {
      "matchFileNames": [
        "teamspeak6/**"
      ],
      "semanticCommitScope": "teamspeak6"
    },
    {
      "matchFileNames": [
        "ts6_manager/**"
      ],
      "semanticCommitScope": "ts6_manager"
    },
    {
      "matchFileNames": [
        "unbound/**"
      ],
      "semanticCommitScope": "unbound"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "minimumReleaseAge": "0 days",
      "automerge": false,
      "groupName": "github-actions (digest pinning)"
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "enabled": false
    }
  ],
  "ignorePaths": [
    "wiki/**"
  ]
}
