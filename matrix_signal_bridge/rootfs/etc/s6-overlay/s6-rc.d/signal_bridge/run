#!/usr/bin/with-contenv bashio
# S6 service: mautrix-signal bridge

CONFIG_PATH="/data/config.yaml"
REG_PATH="/data/registration.yaml"

# ── Wait until cont-init has written config.yaml ──────────────────────
# (S6 and cont-init run in parallel — without the wait the bridge starts too early)
WAIT=0
while [ ! -f "${CONFIG_PATH}" ]; do
    if [ $WAIT -eq 0 ]; then
        bashio::log.info "Waiting for config.yaml..."
    fi
    sleep 1
    WAIT=$((WAIT + 1))
    if [ $WAIT -gt 60 ]; then
        bashio::log.error "Timeout: config.yaml was not created!"
        exit 1
    fi
done

bashio::log.info "Starting mautrix-signal..."
exec mautrix-signal -c "${CONFIG_PATH}" -r "${REG_PATH}" \
    2>&1
