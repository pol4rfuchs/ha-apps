{
  "_comment": "Single source of truth for the 19-version-badges-sync workflow. Each entry maps a value extracted from a real repo file (Dockerfile/config.yaml/script) onto a badge and/or a README table row. Add a new addon here, no workflow YAML changes needed.",
  "forgejo": {
    "readme": "README.md",
    "items": [
      {
        "value_from": { "file": "Dockerfile", "regex": "ARG FORGEJO_IMAGE_VERSION=(\\S+)" },
        "badge": { "label": "Forgejo", "color": "609926" },
        "table_row_label": "Forgejo version",
        "table_value_format": "`{value}`"
      },
      {
        "value_from": { "file": "config.yaml", "regex": "^version:\\s*\"?([^\"\\n]+)\"?" },
        "table_row_label": "Add-on version",
        "table_value_format": "`{value}`"
      }
    ]
  },
  "intiface_central": {
