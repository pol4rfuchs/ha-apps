#!/usr/bin/with-contenv bashio
EXIT_CODE="$1"
SIGNAL="$2"
if [ "${EXIT_CODE}" = "256" ]; then
    bashio::log.info "whatsapp_bridge terminated by signal ${SIGNAL} (normal on container stop/restart)"
elif [ "${EXIT_CODE}" = "0" ]; then
    bashio::log.info "whatsapp_bridge exited cleanly (exit code: 0)"
else
    bashio::log.warning "whatsapp_bridge exited unexpectedly (exit code: ${EXIT_CODE})"
fi
