#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
set -euo pipefail

# shellcheck source=/dev/null
source /usr/local/lib/linkwarden-ha/common.sh
lw_apply_log_level
lw_export_env

waited=0
until "${PG_BIN}/pg_isready" -q -h 127.0.0.1 -p 5432 > /dev/null 2>&1; do
  waited=$((waited + 1))
  if [ "${waited}" -gt 120 ]; then
    bashio::log.error "Timeout while waiting for PostgreSQL."
    exit 1
  fi
  sleep 1
done

# Apply the schema before anything else touches the database. The worker waits for this marker.
rm -f "${LW_READY_FILE}"
cd "${LW_DIR}"
bashio::log.info "Applying database migrations..."
# DATABASE_URL and PATH are already exported by lw_export_env and gosu keeps the environment; they are not passed
# on the command line, where the password would show up in the process list.
gosu "${LW_USER}" prisma migrate deploy --schema "${LW_DIR}/packages/prisma/schema.prisma"
touch "${LW_READY_FILE}"

cd "${LW_DIR}/apps/web"
export LW_LOG_LEVEL
# Preload only for the web process itself, not for the helpers above.
export NODE_OPTIONS="--require /usr/local/lib/linkwarden-loglevel.cjs"
bashio::log.info "Starting Linkwarden on port ${LW_PORT}..."
exec gosu "${LW_USER}" next start -p "${LW_PORT}" -H 0.0.0.0
