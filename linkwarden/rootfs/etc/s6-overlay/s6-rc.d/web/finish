#!/command/with-contenv bashio
# shellcheck shell=bash
# The web service is essential: if it crashes, stop the container so the Supervisor restarts it.
# $1 = exit code (256 = terminated by a signal, $2 = signal number)
if [[ "${1}" -ne 0 && "${1}" -ne 256 ]]; then
  bashio::log.warning "web exited with exit code ${1} - stopping the container."
  # Pass the exit code on, otherwise the container ends with 0 (= "stopped cleanly")
  echo "${1}" > /run/s6-linux-init-container-results/exitcode
  /run/s6/basedir/bin/halt
fi
bashio::log.info "web stopped."
