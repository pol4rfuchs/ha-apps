#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Forgejo – s6 Finish Script
# Called when the run process ends (crash or normal exit).
# Prints the exit code and signal, shuts s6 down.
# ==============================================================================
readonly exit_code_service="${1}"
readonly exit_code_signal="${2}"
readonly service="forgejo"

bashio::log.warning \
    "Service ${service} exited with code ${exit_code_service}" \
    "(Signal ${exit_code_signal})"

# Shut down s6 supervision → container ends → HA Supervisor restarts it
s6-svscanctl -t /run/s6/services
