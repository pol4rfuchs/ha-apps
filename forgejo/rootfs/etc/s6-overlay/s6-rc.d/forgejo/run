#!/usr/bin/with-contenv bashio
# ==============================================================================
# Forgejo – s6 run script (longrun service)
# Shebang with-contenv: loads the container env, then bashio (from the HA base image)
#
# Flow:
#   1. Read the HA add-on options via bashio
#   2. Set the FORGEJO__ environment variables
#   3. Derive the public URL (ROOT_URL) from the domain option
#   4. Source the setup script (app.ini, SSH keys, permissions)
#   5. Start Forgejo as the git user (gosu for correct privilege dropping)
# ==============================================================================
set -e

bashio::log.info "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
bashio::log.info " Forgejo v16 – Home Assistant add-on"
bashio::log.info "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

# ── 1. Read the HA configuration ─────────────────────────────────────────────────
APP_NAME="$(bashio::config 'app_name')"
DOMAIN="$(bashio::config 'domain')"
SSL="$(bashio::config 'ssl')"
CERTFILE="$(bashio::config 'certfile')"
KEYFILE="$(bashio::config 'keyfile')"
SSH_ENABLED="$(bashio::config 'ssh_enabled')"
SSH_PORT="$(bashio::config 'ssh_port')"
LOG_LEVEL="$(bashio::config 'log_level')"

# ── 2. Base environment variables ───────────────────────────────────────────────
export GITEA_CUSTOM="/config"
export GITEA_WORK_DIR="/var/lib/gitea"
export GITEA_TEMP="/tmp/gitea"
export GITEA_APP_INI="/config/conf/app.ini"
export HOME="/var/lib/gitea/git"
export USER="git"

export APP_NAME
export HTTP_PORT=3000
export DB_TYPE="sqlite3"
export DB_PATH="/config/data/forgejo.db"

# Forgejo base settings via the environment-to-ini format
export FORGEJO__server__HTTP_PORT=3000
export FORGEJO__server__APP_DATA_PATH="/config/data"
export FORGEJO__repository__ROOT="/config/repositories"
export FORGEJO__log__ROOT_PATH="/config/log"
export FORGEJO__log__LEVEL="${LOG_LEVEL}"
export FORGEJO__database__DB_TYPE="sqlite3"
export FORGEJO__database__PATH="/config/data/forgejo.db"
export FORGEJO__session__PROVIDER="file"
export FORGEJO__session__PROVIDER_CONFIG="/config/data/sessions"
export FORGEJO__cache__ENABLED="true"
export FORGEJO__cache__ADAPTER="memory"
export FORGEJO__queue__TYPE="level"
export FORGEJO__queue__DATADIR="/config/data/queues"
export FORGEJO____APP_NAME="${APP_NAME}"

# ── 3. SSH configuration ──────────────────────────────────────────────────────
if [ "${SSH_ENABLED}" = "true" ]; then
    bashio::log.info "SSH enabled on port ${SSH_PORT}"
    export DISABLE_SSH="false"
    export START_SSH_SERVER="true"
    export SSH_PORT
    export SSH_LISTEN_PORT="${SSH_PORT}"
    export FORGEJO__server__DISABLE_SSH="false"
    export FORGEJO__server__START_SSH_SERVER="true"
    export FORGEJO__server__SSH_PORT="${SSH_PORT}"
    export FORGEJO__server__SSH_LISTEN_PORT="${SSH_PORT}"
    export FORGEJO__server__SSH_SERVER_HOST_KEYS="/config/ssh/forgejo_host_ed25519,/config/ssh/forgejo_host_rsa"
else
    bashio::log.info "SSH disabled"
    export DISABLE_SSH="true"
    export START_SSH_SERVER="false"
    export FORGEJO__server__DISABLE_SSH="true"
fi

# ── 4. Domain / ROOT_URL / SSL ────────────────────────────────────────────────
if [ -n "${DOMAIN}" ] && [ "${DOMAIN}" != "null" ]; then
    # Explicit domain set → derive ROOT_URL from it
    export DOMAIN
    export FORGEJO__server__DOMAIN="${DOMAIN}"

    if [ "${SSL}" = "true" ]; then
        bashio::log.info "SSL enabled for ${DOMAIN}"
        export FORGEJO__server__ROOT_URL="https://${DOMAIN}/"
        export FORGEJO__server__PROTOCOL="https"
        export FORGEJO__server__CERT_FILE="/ssl/${CERTFILE}"
        export FORGEJO__server__KEY_FILE="/ssl/${KEYFILE}"
        export ROOT_URL="https://${DOMAIN}/"
    else
        export FORGEJO__server__ROOT_URL="http://${DOMAIN}:3000/"
        export ROOT_URL="http://${DOMAIN}:3000/"
    fi

    bashio::log.info "ROOT_URL: ${ROOT_URL}"
else
    # No domain set → Forgejo does not know its address. Ingress no longer exists
    # since 16.0.17, so only the localhost fallback remains. Links and
    # clone URLs then point to localhost until domain is set to the address in use
    # (HA hostname or LAN IP).
    export FORGEJO__server__ROOT_URL="http://localhost:3000/"
    export ROOT_URL="http://localhost:3000/"
    bashio::log.warning "Option 'domain' is not set – ROOT_URL is http://localhost:3000/."
    bashio::log.warning "Set 'domain' to the hostname or LAN IP you use to reach Forgejo (e.g. the IP of your HA host) so links and clone URLs are correct."
fi

# ── 5. Run setup (as root: dirs, keys, app.ini, permissions) ──────────
bashio::log.info "Running setup..."
# shellcheck source=/etc/s6-overlay/s6-rc.d/forgejo/setup
source /etc/s6-overlay/s6-rc.d/forgejo/setup

# ── 6. Summary ────────────────────────────────────────────────────────
bashio::log.info "App name  : ${APP_NAME}"
bashio::log.info "Root URL  : ${ROOT_URL:-not set}"
bashio::log.info "SSH       : ${SSH_ENABLED} $([ "${SSH_ENABLED}" = "true" ] && echo "(Port ${SSH_PORT})" || echo "")"
bashio::log.info "SSL       : ${SSL}"
bashio::log.info "Log level : ${LOG_LEVEL}"
bashio::log.info "Data      : /config (addon_config)"

# ── 7. Start Forgejo ────────────────────────────────────────────────────────
# gosu: safe privilege dropping to the git user (no sudo, no su)
# cd: Forgejo expects the work dir as CWD
bashio::log.info "Starting Forgejo as git user..."
cd /var/lib/gitea
exec gosu git /app/gitea/gitea web \
    --config "${GITEA_APP_INI}" \
    --work-path "${GITEA_WORK_DIR}"
