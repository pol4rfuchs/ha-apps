#!/bin/bash
# ==============================================================================
# Forgejo – Setup Script
# Runs as root BEFORE the Forgejo process (sourced from run)
# Tasks:
#   1. Create directories
#   2. Generate persistent SSH host keys (once)
#   3. Create app.ini from the template (once, on first start)
#   4. environment-to-ini: FORGEJO__SECTION__KEY env vars → app.ini
#   5. Fix permissions
# ==============================================================================
set -e

# ── 1. Directories ──────────────────────────────────────────────────────────
mkdir -p \
    "${GITEA_CUSTOM}/conf" \
    "${GITEA_CUSTOM}/data" \
    "${GITEA_CUSTOM}/repositories" \
    "${GITEA_CUSTOM}/log" \
    "${GITEA_CUSTOM}/git/.ssh" \
    "${GITEA_CUSTOM}/ssh" \
    "${GITEA_TEMP}"

chmod 700 "${GITEA_CUSTOM}/git/.ssh"

# ── 2. SSH host keys (persistent, once) ───────────────────────────────────
# Persistent keys prevent "Host key changed" warnings after a restart.
# They are stored in addon_config (/config/ssh/) → they survive updates.
if [ ! -f "${GITEA_CUSTOM}/ssh/forgejo_host_ed25519" ]; then
    echo "[setup] Generating SSH host keys..."
    ssh-keygen -t ed25519 \
        -f "${GITEA_CUSTOM}/ssh/forgejo_host_ed25519" \
        -N "" -q
    ssh-keygen -t rsa -b 3072 \
        -f "${GITEA_CUSTOM}/ssh/forgejo_host_rsa" \
        -N "" -q
    chown git:git "${GITEA_CUSTOM}/ssh/"*
    chmod 600 "${GITEA_CUSTOM}/ssh/"*
    echo "[setup] SSH host keys generated"
fi

# ── 3. app.ini from the template (once, on first start) ─────────────────────
# Only if no app.ini exists yet. After that it is kept
# and can be edited directly by the user (via the HA file editor).
if [ ! -f "${GITEA_CUSTOM}/conf/app.ini" ]; then
    echo "[setup] Creating app.ini from template..."

    # Set defaults for envsubst (overridden by FORGEJO__ vars)
    APP_NAME="${APP_NAME:-Forgejo}"                         \
    DOMAIN="${DOMAIN:-localhost}"                           \
    HTTP_PORT="${HTTP_PORT:-3000}"                          \
    ROOT_URL="${ROOT_URL:-}"                                \
    DISABLE_SSH="${DISABLE_SSH:-false}"                     \
    START_SSH_SERVER="${START_SSH_SERVER:-false}"           \
    SSH_PORT="${SSH_PORT:-22}"                              \
    SSH_LISTEN_PORT="${SSH_LISTEN_PORT:-22}"                \
    DB_TYPE="${DB_TYPE:-sqlite3}"                           \
    DB_PATH="${DB_PATH:-${GITEA_CUSTOM}/data/forgejo.db}"  \
    INSTALL_LOCK="${INSTALL_LOCK:-false}"                   \
    SECRET_KEY="${SECRET_KEY:-}"                            \
    DISABLE_REGISTRATION="${DISABLE_REGISTRATION:-false}"  \
    REQUIRE_SIGNIN_VIEW="${REQUIRE_SIGNIN_VIEW:-false}"     \
    LFS_START_SERVER="${LFS_START_SERVER:-false}"           \
    envsubst < /etc/templates/app.ini > "${GITEA_CUSTOM}/conf/app.ini"

    chown git:git "${GITEA_CUSTOM}/conf/app.ini"
    echo "[setup] app.ini created: ${GITEA_CUSTOM}/conf/app.ini"
fi

# ── 4. environment-to-ini: FORGEJO__SECTION__KEY → app.ini ───────────────────
# Processes all FORGEJO__ environment variables and writes them to app.ini.
# This is Forgejo's own tool – clean and correct.
# run sets all FORGEJO__ vars before setup is sourced.
echo "[setup] Applying FORGEJO__ environment variables to app.ini..."
environment-to-ini --config "${GITEA_CUSTOM}/conf/app.ini"

# ── 5. Permissions ────────────────────────────────────────────────────────────
# Only chown if needed (saves time with large repos)
if ! [[ "$(stat -c '%U' "${GITEA_CUSTOM}/data" 2>/dev/null)" = "git" ]]; then
    chown -R git:git "${GITEA_CUSTOM}"
fi
if ! [[ "$(stat -c '%U' /var/lib/gitea 2>/dev/null)" = "git" ]]; then
    chown -R git:git /var/lib/gitea
fi
chmod 0755 "${GITEA_CUSTOM}" /var/lib/gitea

echo "[setup] Setup complete"
