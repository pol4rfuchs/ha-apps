#!/command/with-contenv bashio
# shellcheck shell=bash
# unifi-control is the only long-running process: when it ends, shut the
# container down so the Home Assistant Supervisor can restart it cleanly.
# s6-overlay v3: halt replaces the old s6-svscanctl call (HA base images).
set -euo pipefail
EXIT_CODE="${1:-1}"
if [ "${EXIT_CODE}" -ne 0 ] && [ "${EXIT_CODE}" -ne 256 ]; then
  bashio::log.error "UniFi OS Control Center exited with code ${EXIT_CODE}"
fi
exec /run/s6/basedir/bin/halt
