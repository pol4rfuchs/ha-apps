#!/command/with-contenv bashio
# shellcheck shell=bash
# If the main process crashes, stop the container so the Supervisor restarts it.
# $1 = exit code (256 = terminated by signal, $2 = signal number)
if [[ "${1}" -ne 0 && "${1}" -ne 256 ]]; then
  bashio::log.warning "Vaultwarden exited with exit code ${1} – stopping the container."
  # Pass the exit code on to the container, otherwise it ends with 0 (= "stopped cleanly")
  echo "${1}" > /run/s6-linux-init-container-results/exitcode
  /run/s6/basedir/bin/halt
fi
bashio::log.info "Vaultwarden stopped."
