#!/usr/bin/with-contenv bashio
# S6 Service: Synapse Homeserver

SYNAPSE_CONFIG="/data/matrix/synapse/homeserver.yaml"
MARKER="/data/matrix/.pg_initialized"

# ── Wait until cont-init has written homeserver.yaml ─────────────────────
# (S6 and cont-init run in parallel — without the wait Synapse starts too early)
WAIT=0
while [ ! -f "${SYNAPSE_CONFIG}" ]; do
    if [ $WAIT -eq 0 ]; then
        bashio::log.info "Waiting for homeserver.yaml..."
    fi
    sleep 1
    WAIT=$((WAIT + 1))
    if [ $WAIT -gt 120 ]; then
        bashio::log.error "Timeout: homeserver.yaml was not created!"
        exit 1
    fi
done

# ── Wait until PostgreSQL is ready ───────────────────────────────────────
bashio::log.info "Waiting for PostgreSQL..."
for i in $(seq 1 60); do
    if [ -f "${MARKER}" ] && pg_isready -h 127.0.0.1 -p 5432 -U synapse -q 2>/dev/null; then
        bashio::log.info "✅ PostgreSQL ready"
        break
    fi
    sleep 1
done

# jemalloc as the allocator for Synapse only (like the official Synapse image):
# less fragmentation, and a prerequisite for caches.cache_autotuning.
if [ -e /usr/local/lib/libjemalloc.so.2 ]; then
    export LD_PRELOAD=/usr/local/lib/libjemalloc.so.2
else
    bashio::log.warning "jemalloc not found – Synapse runs with the default allocator, so the cache upper limit does not apply."
fi

bashio::log.info "Starting Synapse homeserver..."
exec /opt/synapse/bin/python -m synapse.app.homeserver \
    --config-path "${SYNAPSE_CONFIG}" \
    2>&1
