#!/usr/bin/with-contenv bashio
# S6 Service: PostgreSQL

PG_DATA="/data/matrix/postgresql"
PG_BIN="/usr/lib/postgresql/15/bin"
MARKER="/data/matrix/.pg_initialized"

# ── Wait until cont-init has fully initialized the DB ─────────────────────
# cont-init and S6 services start in PARALLEL — without this wait there is
# a race condition: S6 tries to start postgres while initdb is running.
WAIT=0
while [ ! -f "${MARKER}" ]; do
    if [ $WAIT -eq 0 ]; then
        bashio::log.info "Waiting for PostgreSQL initialization by cont-init..."
    fi
    sleep 1
    WAIT=$((WAIT + 1))
    if [ $WAIT -gt 120 ]; then
        bashio::log.error "Timeout: PostgreSQL initialization is taking too long!"
        exit 1
    fi
done

bashio::log.info "Starting PostgreSQL..."

exec gosu postgres "${PG_BIN}/postgres" \
    -D "${PG_DATA}" \
    -c "listen_addresses=127.0.0.1" \
    -c "port=5432" \
    2>&1
