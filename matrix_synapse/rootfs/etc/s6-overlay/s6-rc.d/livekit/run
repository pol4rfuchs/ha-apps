#!/usr/bin/with-contenv bashio

if ! bashio::config.true 'enable_voice_calls'; then
    bashio::log.info "LiveKit: Voice Calls deaktiviert — Service inaktiv"
    exec sleep infinity
fi

LK_CONFIG="/data/matrix/livekit.yaml"
LK_BIN="/data/matrix/bin/livekit-server"

# Warten bis Binary vorhanden
WAIT=0
while [ ! -x "${LK_BIN}" ]; do
    if [ $WAIT -eq 0 ]; then
        bashio::log.info "LiveKit: Warte auf Binary Download..."
    fi
    sleep 2
    WAIT=$((WAIT + 2))
    if [ $WAIT -gt 300 ]; then
        bashio::log.error "Timeout: livekit-server Binary nicht gefunden!"
        exec sleep infinity
    fi
done
ln -sf "${LK_BIN}" /usr/local/bin/livekit-server

# Warten bis cont-init die Config FRISCH geschrieben hat
# (nicht eine evtl. veraltete Config vom letzten Start lesen)
# Erkennbar daran dass homeserver.yaml auch frisch ist — beide werden im selben Script geschrieben
SYNAPSE_CONFIG="/data/matrix/synapse/homeserver.yaml"
WAIT=0
while [ ! -f "${LK_CONFIG}" ] || [ ! -f "${SYNAPSE_CONFIG}" ]; do
    if [ $WAIT -eq 0 ]; then
        bashio::log.info "LiveKit: Warte auf Config-Generierung..."
    fi
    sleep 1
    WAIT=$((WAIT + 1))
    if [ $WAIT -gt 120 ]; then
        bashio::log.error "Timeout: livekit.yaml nicht gefunden!"
        exec sleep infinity
    fi
done

# LiveKit prüft die Config strikt: ein unbekanntes Feld beendet den Start sofort
# mit exit 1 ("field <name> not found"). livekit-server wird bei jedem Start auf
# "latest" aktualisiert; kennt eine Version skip_external_ip_validation nicht
# (mehr), läuft Voice ohne die Option weiter, statt komplett auszufallen.
# Probestart: Eine gültige Config läuft bis zum Timeout (124), eine abgelehnte
# endet sofort. Nur wenn genau dieses Feld bemängelt wird, fliegt seine Zeile raus.
livekit_config_fallback() {
    local cfg="$1" out="" rc=0
    grep -q '^  skip_external_ip_validation:' "${cfg}" || return 0
    out="$(timeout 2 livekit-server --config "${cfg}" 2>&1)" || rc=$?
    if [ "${rc}" -ne 124 ]; then
        case "${out}" in
            *skip_external_ip_validation*)
                sed -i '/^  skip_external_ip_validation:/d' "${cfg}"
                bashio::log.warning "LiveKit kennt skip_external_ip_validation nicht — starte ohne die Option (Hairpin-NAT-Router können die öffentliche IP dann verwerfen)"
                ;;
        esac
    fi
    return 0
}

# Zusätzlich kurz warten bis cont-init komplett durch ist
sleep 3

livekit_config_fallback "${LK_CONFIG}"

bashio::log.info "🚀 Starte LiveKit SFU auf Port 7880 (TURN UDP 3478)..."
exec livekit-server --config "${LK_CONFIG}" 2>&1
