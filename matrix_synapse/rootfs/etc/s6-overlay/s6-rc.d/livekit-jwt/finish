#!/bin/sh
EXIT_CODE="$1"
SIGNAL="$2"
if [ "${EXIT_CODE}" = "256" ]; then
    echo "[livekit-jwt] Service terminated by signal ${SIGNAL} (normal on container stop/restart)"
elif [ "${EXIT_CODE}" = "0" ]; then
    echo "[livekit-jwt] Service exited cleanly (exit code: 0)"
else
    echo "[livekit-jwt] Service exited unexpectedly (exit code: ${EXIT_CODE})"
fi
