#!/usr/bin/with-contenv bashio
# S6 Service: Synapse Admin UI (Python HTTP Server Port 8090)

ENABLE_ADMIN=$(bashio::config 'enable_synapse_admin')
if [ "${ENABLE_ADMIN}" != "true" ]; then
    bashio::log.info "Synapse Admin UI (Ketesa) is disabled (enable_synapse_admin: false) — service stays inactive."
    exec sleep infinity
fi

READY_FILE="/data/matrix/synapse-admin/index.html"

WAIT=0
while [ ! -f "${READY_FILE}" ]; do
    if [ $WAIT -eq 0 ]; then
        bashio::log.info "Waiting for Synapse Admin download..."
    fi
    sleep 1
    WAIT=$((WAIT + 1))
    if [ $WAIT -gt 120 ]; then
        bashio::log.error "Timeout: Synapse Admin not found!"
        exit 1
    fi
done

AUTH_FILE="/data/matrix/.admin_ui_auth"
if [ ! -f "${AUTH_FILE}" ]; then
    bashio::log.error "Admin UI auth file missing (${AUTH_FILE}) — did 10-matrix-init.sh not run?"
    exit 1
fi
export ADMIN_UI_USER
export ADMIN_UI_PASSWORD
ADMIN_UI_USER=$(sed -n '1p' "${AUTH_FILE}")
ADMIN_UI_PASSWORD=$(sed -n '2p' "${AUTH_FILE}")

bashio::log.info "Starting Synapse Admin UI (Ketesa) on port 8090 with basic auth..."
cd /data/matrix/synapse-admin || exit 1
exec python3 /usr/local/bin/admin-ui-auth-server.py 2>&1
