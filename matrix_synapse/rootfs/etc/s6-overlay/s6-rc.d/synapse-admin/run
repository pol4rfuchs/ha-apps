#!/usr/bin/with-contenv bashio
# S6 Service: Synapse Admin UI (Python HTTP Server Port 8090)

READY_FILE="/data/matrix/synapse-admin/index.html"

WAIT=0
while [ ! -f "${READY_FILE}" ]; do
    if [ $WAIT -eq 0 ]; then
        bashio::log.info "Warte auf Synapse Admin Download..."
    fi
    sleep 1
    WAIT=$((WAIT + 1))
    if [ $WAIT -gt 120 ]; then
        bashio::log.error "Timeout: Synapse Admin nicht gefunden!"
        exit 1
    fi
done

AUTH_FILE="/data/matrix/.admin_ui_auth"
if [ ! -f "${AUTH_FILE}" ]; then
    bashio::log.error "Admin UI Auth-Datei fehlt (${AUTH_FILE}) — 10-matrix-init.sh nicht durchgelaufen?"
    exit 1
fi
export ADMIN_UI_USER
export ADMIN_UI_PASSWORD
ADMIN_UI_USER=$(sed -n '1p' "${AUTH_FILE}")
ADMIN_UI_PASSWORD=$(sed -n '2p' "${AUTH_FILE}")

bashio::log.info "Starte Synapse Admin UI (Ketesa) auf Port 8090 mit Basic-Auth..."
cd /data/matrix/synapse-admin
exec python3 /usr/local/bin/admin-ui-auth-server.py 2>&1
