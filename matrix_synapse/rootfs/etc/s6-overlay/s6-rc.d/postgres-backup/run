#!/usr/bin/with-contenv bashio
# S6 service: periodic PostgreSQL backups via pg_dump
#
# Why pg_dump instead of relying on HA snapshots alone: an HA snapshot
# copies /data/matrix/postgresql while it is running (hot copy) — that is
# not a consistent database state. pg_dump produces a logical, internally
# consistent backup that can, if needed, also be restored into a different
# Postgres version/instance.

BACKUP_ENABLED=$(bashio::config 'backup_enabled')
BACKUP_INTERVAL_HOURS=$(bashio::config 'backup_interval_hours')
BACKUP_RETENTION_DAYS=$(bashio::config 'backup_retention_days')

BACKUP_DIR="/data/matrix/backups"
mkdir -p "${BACKUP_DIR}"

if [ "${BACKUP_ENABLED}" != "true" ]; then
    bashio::log.info "postgres-backup: backup_enabled=false — service stays idle"
    # a longrun service must not exit immediately (otherwise restart loop) — sleep and stay alive
    exec sleep infinity
fi

bashio::log.info "postgres-backup: active, interval=${BACKUP_INTERVAL_HOURS}h, retention=${BACKUP_RETENTION_DAYS}d"

# First run 2 minutes after start, so Postgres/Synapse are certainly up
sleep 120

while true; do
    TS=$(date +%Y%m%d-%H%M%S)
    DUMP_FILE="${BACKUP_DIR}/synapse_${TS}.sql.gz"

    if gosu postgres pg_dump -U postgres synapse 2>/tmp/pg_dump.err | gzip > "${DUMP_FILE}.tmp"; then
        mv "${DUMP_FILE}.tmp" "${DUMP_FILE}"
        SIZE=$(du -h "${DUMP_FILE}" | cut -f1)
        bashio::log.info "postgres-backup: ✅ ${DUMP_FILE} (${SIZE})"
    else
        rm -f "${DUMP_FILE}.tmp"
        bashio::log.error "postgres-backup: ❌ pg_dump failed: $(cat /tmp/pg_dump.err)"
    fi

    # Rotation: delete old dumps beyond the retention period
    find "${BACKUP_DIR}" -name 'synapse_*.sql.gz' -mtime "+${BACKUP_RETENTION_DAYS}" -delete

    sleep "$((BACKUP_INTERVAL_HOURS * 3600))"
done
