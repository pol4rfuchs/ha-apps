#!/usr/bin/with-contenv bashio
# S6 Service: Element Web (Python HTTP Server)
# Port 7080 — static files, no nginx needed

READY_FILE="/data/matrix/element-web/index.html"

# Wait until Element Web has been downloaded
WAIT=0
while [ ! -f "${READY_FILE}" ]; do
    if [ $WAIT -eq 0 ]; then
        bashio::log.info "Waiting for Element Web download..."
    fi
    sleep 1
    WAIT=$((WAIT + 1))
    if [ $WAIT -gt 120 ]; then
        bashio::log.error "Timeout: Element Web not found!"
        exit 1
    fi
done

bashio::log.info "Starting Element Web on port 7080..."
cd /data/matrix/element-web || exit 1
exec python3 -m http.server 7080 2>&1
