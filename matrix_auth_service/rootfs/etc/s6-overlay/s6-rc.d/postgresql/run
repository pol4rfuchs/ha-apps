#!/usr/bin/with-contenv bashio
# S6 service: PostgreSQL (own instance for MAS, separate from the Synapse DB)

PG_DATA="/data/mas/postgresql"
PG_BIN="/usr/lib/postgresql/17/bin"
MARKER="/data/mas/.pg_initialized"

# ── Wait until cont-init has fully initialized the DB ─────────────────────
# Same race-condition protection as in the Synapse add-on: cont-init and
# S6 services start in PARALLEL.
WAIT=0
while [ ! -f "${MARKER}" ]; do
    if [ $WAIT -eq 0 ]; then
        bashio::log.info "Waiting for PostgreSQL initialization by cont-init..."
    fi
    sleep 1
    WAIT=$((WAIT + 1))
    if [ $WAIT -gt 120 ]; then
        bashio::log.error "Timeout: PostgreSQL initialization is taking too long!"
        exit 1
    fi
done

bashio::log.info "Starting PostgreSQL (MAS)..."

exec gosu postgres "${PG_BIN}/postgres" \
    -D "${PG_DATA}" \
    -c "listen_addresses=127.0.0.1" \
    -c "port=5433" \
    2>&1
